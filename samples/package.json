{
  "name": "samples",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@spfxappdev/sortable": "../lib",
    "cra-template-typescript": "1.2.0",
    "npm-run-all": "^4.1.5",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "start:dev": "cross-env REACT_APP_LOAD_PACKAGE_FROM=local npm-run-all --parallel watch-sortable start",
    "watch-sortable": "tsc --watch --project ../tsconfig.json",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "17.0.45",
    "@types/react-dom": "17.0.17",
    "cross-env": "^7.0.3",
    "typescript": "^5.7.3"
  }
}
